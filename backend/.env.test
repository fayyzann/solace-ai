# Test environment — safe dummy values, never used against real services
# Load with: export $(cat .env.test | xargs) or pytest picks it up via pytest.ini

DATABASE_URL=postgresql+asyncpg://aisupport:localpassword@localhost:5432/aisupport_test
TEST_DATABASE_URL=postgresql+asyncpg://aisupport:localpassword@localhost:5432/aisupport_test
REDIS_URL=redis://localhost:6379/1

# Dummy — all external API calls are mocked in tests
JINA_API_KEY=jina-test-dummy-key
GROQ_API_KEY=gsk_test_dummy_key
SUPABASE_URL=https://test.supabase.co
SUPABASE_SERVICE_KEY=test-service-key

# Real test-only crypto material (safe to commit — not used in prod)
ENCRYPTION_MASTER_KEY=26efa7c909426bf0e933bb8271040495f3cdd90febb1d7c659dc8f0ff47330d5

# Paths are relative to backend/ (where pytest runs from)
JWT_PRIVATE_KEY_PATH=../private.pem
JWT_PUBLIC_KEY_PATH=../public.pem

ENVIRONMENT=test
LOG_LEVEL=WARNING
