# Copy to backend/.env and fill in values

# Database (local dev)
DATABASE_URL=postgresql+asyncpg://aisupport:localpassword@localhost:5432/aisupport_dev
TEST_DATABASE_URL=postgresql+asyncpg://aisupport:localpassword@localhost:5432/aisupport_test

# Redis (local dev)
REDIS_URL=redis://localhost:6379/0

# Supabase (staging/prod)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key from Supabase dashboard>

# Jina AI embeddings
JINA_API_KEY=<from jina.ai dashboard>

# Groq (default LLM)
GROQ_API_KEY=<from console.groq.com>

# Encryption & JWT
ENCRYPTION_MASTER_KEY=<32-byte hex — generate: python -c "import os; print(os.urandom(32).hex())">
JWT_PRIVATE_KEY=<RS256 PEM private key>
JWT_PUBLIC_KEY=<RS256 PEM public key>

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
